# Local development variables for the backend.
#
# Nothing loads this file automatically. Copy it to .env (git-ignored) and export it into
# your shell before starting the backend:
#   cp .env.example .env
#   set -a; source .env; set +a
#   cd backend && ./gradlew run
#
# Deployments set these on the platform instead. backend/.env.example lists every
# supported variable with its default.

# Required outside development. Unset means production rules apply (PostgreSQL, a
# generated JWT secret, non-localhost issuer/audience); `./gradlew run` defaults to development.
APP_ENVIRONMENT=development
PORT=8085

# PostgreSQL from `docker compose up -d db`. Comment out to use in-memory H2 instead.
DATABASE_URL=jdbc:postgresql://localhost:5432/remit
DATABASE_USER=dev
DATABASE_PASSWORD=dev
DB_POOL_SIZE=5

# JWT. Development falls back to a built-in secret. Outside development JWT_SECRET must be
# at least 32 characters, must not be a placeholder (anything containing "change" is rejected),
# and should come from: openssl rand -base64 48
# JWT_SECRET=
JWT_ISSUER=remit
JWT_AUDIENCE=remit-users
