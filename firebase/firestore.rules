rules_version = '2';

// Payments are written only by the backend, through the Admin SDK, which bypasses these rules.
// Clients may read their own payments and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /payments/{paymentId} {
      // Queries must filter on senderUid == the caller's uid, or Firestore rejects them.
      allow read: if request.auth != null && resource.data.senderUid == request.auth.uid;
      allow write: if false;
    }

    // Everything else, including idempotency records, is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
