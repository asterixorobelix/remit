# Backend environment variables (all optional in development, defaults shown).
#
# Nothing loads this file automatically: export the values in your shell
# (set -a; source .env; set +a) or set them on your deployment platform.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# development | staging | production. UNSET MEANS PRODUCTION: staging/production refuse to
# start with H2, a missing/placeholder/short JWT_SECRET, or a localhost JWT issuer/audience.
# `./gradlew run` and docker-compose set development explicitly; the Docker image sets production.
APP_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8085
HOST=0.0.0.0
SHUTDOWN_GRACE_PERIOD_MS=1000
SHUTDOWN_TIMEOUT_MS=5000
# Reverse proxies in front of the server that append to X-Forwarded-For (Railway, Render,
# Fly, nginx: 1). The client address used for rate limiting is read from that position.
# Use 0 when clients connect directly, otherwise they can spoof their address.
TRUSTED_PROXY_HOPS=1
# Root log level (logback). Request logs never include tokens, passwords, or headers.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# H2 (default, in-memory, PostgreSQL compatibility mode is added automatically):
#   jdbc:h2:mem:myproject;DB_CLOSE_DELAY=-1
# PostgreSQL (required outside development). Provider URLs such as
# postgres://user:pass@host:5432/db are converted and their credentials used.
DATABASE_URL=jdbc:postgresql://localhost:5432/myproject
DATABASE_USER=dev
DATABASE_PASSWORD=dev
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
# Apply Flyway migrations on startup.
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Required outside development: at least 32 characters and not a placeholder
# (anything containing "change" is rejected). Generate with: openssl rand -base64 48
# JWT_SECRET=
JWT_ISSUER=http://localhost:8085
JWT_AUDIENCE=http://localhost:8085
JWT_REALM=Access
# Access token lifetime (1 hour).
JWT_EXPIRATION_MS=3600000
# Refresh token lifetime (30 days). Refresh tokens rotate on every use.
JWT_REFRESH_EXPIRATION_MS=2592000000

# -----------------------------------------------------------------------------
# CORS (browser clients only; mobile apps do not need it)
# -----------------------------------------------------------------------------
# Comma-separated host[:port] (http and https) or scheme://host[:port] entries.
# Default: localhost:3000,localhost:5173,127.0.0.1:3000,127.0.0.1:5173 in development, none otherwise.
CORS_ALLOWED_HOSTS=localhost:3000,localhost:5173
# Only needed for cookie-based auth; the API uses bearer tokens.
CORS_ALLOW_CREDENTIALS=false

# -----------------------------------------------------------------------------
# Features and limits
# -----------------------------------------------------------------------------
# Swagger UI at /swagger (default: enabled except in production).
SWAGGER_ENABLED=true
# Per-client limits: login+register share one bucket, refresh+logout another.
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Remote app config served at GET /api/v1/config
# -----------------------------------------------------------------------------
MIN_APP_VERSION=0.0.0
# Defaults to VERSION_NAME from app.properties.
# LATEST_APP_VERSION=
FORCE_UPDATE=false
MAINTENANCE_MODE=false
