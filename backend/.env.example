# Backend environment variables (all optional in development, defaults shown).
#
# Nothing loads this file automatically: export the values in your shell
# (set -a; source .env; set +a) or set them on your deployment platform.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# development | staging | production. UNSET MEANS PRODUCTION: Swagger UI is off and no CORS
# origins are allowed unless set below. `./gradlew run`, `make backend`, and docker-compose set
# development explicitly; the Docker image sets production.
APP_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8085
HOST=0.0.0.0
SHUTDOWN_GRACE_PERIOD_MS=1000
SHUTDOWN_TIMEOUT_MS=5000
# Reverse proxies in front of the server that append to X-Forwarded-For (Railway, Render,
# Fly, nginx: 1). The client address (`call.request.origin`) is read from that position.
# Use 0 when clients connect directly, otherwise they can spoof their address.
TRUSTED_PROXY_HOPS=1
# Root log level (logback). Request logs never include headers or bodies.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CORS (browser clients only; mobile apps do not need it)
# -----------------------------------------------------------------------------
# Comma-separated host[:port] (http and https) or scheme://host[:port] entries.
# Default: localhost:3000,localhost:5173,127.0.0.1:3000,127.0.0.1:5173 in development, none otherwise.
CORS_ALLOWED_HOSTS=localhost:3000,localhost:5173
# Only needed for cookie-based browser sessions.
CORS_ALLOW_CREDENTIALS=false

# -----------------------------------------------------------------------------
# Features
# -----------------------------------------------------------------------------
# Swagger UI at /swagger (default: enabled except in production).
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Remote app config served at GET /api/v1/config
# -----------------------------------------------------------------------------
MIN_APP_VERSION=0.0.0
# Defaults to VERSION_NAME from app.properties.
# LATEST_APP_VERSION=
FORCE_UPDATE=false
MAINTENANCE_MODE=false
