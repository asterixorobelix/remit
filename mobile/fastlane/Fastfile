# Fastfile — Unified Deployment Automation
#
# Single Fastfile for both Android and iOS. All lanes live here.
# Run from: mobile/fastlane/
#
# Quick reference:
#   Android:
#     fastlane android test             Run unit tests
#     fastlane android lint             Run detekt
#     fastlane android build_release    Build signed AAB
#     fastlane android internal         Local: test + lint + bump + build + upload
#     fastlane android ci_internal      CI: build + upload (no tests/bump)
#     fastlane android beta             Deploy to Beta (Open Testing)
#     fastlane android release          Deploy to Production (staged rollout)
#     fastlane android promote_to_beta  Promote Internal -> Beta
#     fastlane android promote_to_production  Promote Beta -> Production
#     fastlane android upload_metadata  Upload metadata only
#
#   iOS:
#     fastlane ios certificates         Sync appstore certs
#     fastlane ios certificates_dev     Sync dev certs
#     fastlane ios build                Build for App Store
#     fastlane ios beta                 Deploy to TestFlight (internal)
#     fastlane ios beta_external        Deploy to TestFlight (external)
#     fastlane ios release              Upload to App Store Connect
#     fastlane ios release_submit       Upload + submit for review
#     fastlane ios upload_metadata      Upload metadata/screenshots only
#     fastlane ios submit_for_review    Submit current build for review
#
#   Utility:
#     fastlane check_env               Validate environment variables
#     fastlane clean                    Clean build artifacts

default_platform(:android)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# App Store Connect API Key (avoids password/2FA on CI)
def asc_api_key
  if ENV['ASC_KEY_ID'] && ENV['ASC_ISSUER_ID'] && ENV['ASC_KEY_CONTENT']
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: true
    )
  else
    nil
  end
end

# app.properties (repository root) is the single source of app identity.
def app_property(key)
  path = File.expand_path("../../app.properties", __dir__)
  line = File.readlines(path).find { |l| l.start_with?("#{key}=") }
  line && line.split("=", 2).last.strip
end

def android_package
  ENV["ANDROID_PACKAGE_NAME"] || app_property("PACKAGE_NAME")
end

def ios_app_identifier
  ENV["IOS_APP_IDENTIFIER"] || app_property("PACKAGE_NAME")
end

# Service-account JSON from GOOGLE_PLAY_SERVICE_ACCOUNT_JSON (raw or base64); falls back to
# the Appfile json_key_file when unset (local runs).
def play_credentials
  json = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"].to_s.strip
  creds = { package_name: android_package }
  return creds if json.empty?
  creds[:json_key_data] = json.start_with?("{") ? json : json.unpack1("m")
  creds
end

# Resolve paths relative to this Fastfile so cwd doesn't matter
def mobile_root
  File.expand_path("..", __dir__)
end

def android_app_root
  File.join(mobile_root, "androidApp")
end

def ios_workspace_path
  File.join(mobile_root, "iosApp", "iosApp.xcworkspace")
end

def ios_project_workspace_path
  File.join(mobile_root, "iosApp", "iosApp.xcodeproj", "project.xcworkspace")
end

def ios_project_path
  File.join(mobile_root, "iosApp", "iosApp.xcodeproj")
end

# Auto-detect workspace vs project for Xcode builds
def ios_project_container
  if File.directory?(ios_workspace_path)
    { workspace: ios_workspace_path }
  elsif File.directory?(ios_project_workspace_path)
    { workspace: ios_project_workspace_path }
  else
    { project: ios_project_path }
  end
end

def release_aab_path
  File.join(android_app_root, "build/outputs/bundle/release/androidApp-release.aab")
end

# Stores reject a build number they already have, so a release retried after a late failure
# (for example "Re-run failed jobs" in Mobile CD) must skip uploads that already succeeded.
def play_track_has_version_code?(track)
  code = app_property("VERSION_CODE").to_i
  google_play_track_version_codes(**play_credentials, track: track).map(&:to_i).include?(code)
rescue StandardError => e
  UI.important("Could not read the #{track} track (#{e.message}); uploading anyway.")
  false
end

# Store listing files generated by sync_store_listing.rb (gitignored) and screenshots.
def ios_metadata_path
  File.join(mobile_root, "fastlane", "metadata", "ios")
end

def ios_screenshots_path
  File.join(mobile_root, "fastlane", "screenshots", "ios")
end

# RELEASE_NOTES (set by Mobile CD from conventional commits, or by hand) becomes the Play
# "What's new" text for this version code. Play allows 500 characters per language.
def play_release_notes_options
  notes = ENV["RELEASE_NOTES"].to_s.strip
  return { skip_upload_changelogs: true } if notes.empty?
  metadata = File.join(mobile_root, "fastlane", "metadata", "android")
  dir = File.join(metadata, ENV.fetch("PLAY_LOCALE", "en-US"), "changelogs")
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "#{app_property('VERSION_CODE')}.txt"), notes[0, 500])
  { metadata_path: metadata, skip_upload_changelogs: false }
end

# Comma-separated TESTFLIGHT_EXTERNAL_GROUPS; unset or empty falls back to "Beta Testers".
def testflight_external_groups
  groups = ENV["TESTFLIGHT_EXTERNAL_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
  groups.empty? ? ["Beta Testers"] : groups
end

def testflight_has_build?
  latest = latest_testflight_build_number(
    api_key: asc_api_key,
    app_identifier: ios_app_identifier,
    version: app_property("VERSION_NAME"),
    initial_build_number: 0
  )
  latest.to_i >= app_property("VERSION_CODE").to_i
rescue StandardError => e
  UI.important("Could not read TestFlight builds (#{e.message}); uploading anyway.")
  false
end

# ============================================================================
# ANDROID
# ============================================================================
platform :android do

  desc "Run unit tests"
  lane :test do
    gradle(project_dir: mobile_root, task: ":composeApp:testAndroidHostTest")
  end

  desc "Run detekt code analysis"
  lane :lint do
    gradle(project_dir: mobile_root, task: "detekt")
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(project_dir: mobile_root, task: ":androidApp:assembleDebug")
    UI.success("Debug APK: #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]}")
  end

  desc "Build signed release AAB"
  lane :build_release do
    ensure_env_vars(env_vars: %w[KEYSTORE_PATH KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD])

    gradle(
      project_dir: mobile_root,
      task: ":androidApp:bundleRelease",
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
    UI.success("Release AAB: #{release_aab_path}")
  end

  desc "Build signed release APK (direct distribution)"
  lane :build_release_apk do
    ensure_env_vars(env_vars: %w[KEYSTORE_PATH KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD])

    gradle(
      project_dir: mobile_root,
      task: ":androidApp:assembleRelease",
      properties: {
        "android.injected.signing.store.file" => ENV["KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"]
      }
    )
  end

  desc "Increment the shared app.properties version"
  lane :bump_version do
    sh(File.join(mobile_root, "..", "bump-version.sh"), "patch", "--yes")
  end

  # -- Deployment lanes --

  desc "Local deploy: test + lint + bump + build + upload to Internal"
  lane :internal do
    test
    lint
    bump_version
    build_release
    upload_to_play_store(
      **play_credentials,
      track: "internal",
      aab: release_aab_path,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      release_status: "completed"
    )
    UI.success("Deployed to Internal Testing!")
  end

  desc "CI deploy: build + upload to Internal (no tests/bump)"
  lane :ci_internal do |options|
    next UI.important("Version code already on the internal track; skipping upload.") if play_track_has_version_code?("internal")
    build_release unless options[:skip_build]
    upload_to_play_store(
      **play_credentials,
      track: "internal",
      aab: release_aab_path,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      release_status: "completed",
      **play_release_notes_options
    )
    UI.success("Deployed to Internal Testing!")
  end

  desc "CI deploy: build + upload to Beta (no tests/bump)"
  lane :ci_beta do |options|
    next UI.important("Version code already on the beta track; skipping upload.") if play_track_has_version_code?("beta")
    build_release unless options[:skip_build]
    upload_to_play_store(
      **play_credentials,
      track: "beta",
      aab: release_aab_path,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      **play_release_notes_options
    )
    UI.success("Deployed to Beta!")
  end

  desc "CI deploy: build + upload to Production (no tests/bump)"
  lane :ci_release do |options|
    next UI.important("Version code already on the production track; skipping upload.") if play_track_has_version_code?("production")
    pct = options[:rollout] || 0.1
    build_release unless options[:skip_build]
    upload_to_play_store(
      **play_credentials,
      track: "production",
      aab: release_aab_path,
      rollout: pct.to_s,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      **play_release_notes_options
    )
    UI.success("Deployed to Production at #{(pct.to_f * 100).to_i}% rollout!")
  end

  desc "Deploy to Beta (Open Testing)"
  lane :beta do
    test
    lint
    bump_version
    build_release
    upload_to_play_store(
      **play_credentials,
      track: "beta",
      aab: release_aab_path,
      skip_upload_metadata: false, skip_upload_images: true, skip_upload_screenshots: true
    )
    UI.success("Deployed to Beta!")
  end

  desc "Deploy to Production (staged rollout, default 10%)"
  lane :release do |options|
    pct = options[:rollout] || 0.1
    test
    lint
    bump_version
    build_release
    upload_to_play_store(
      **play_credentials,
      track: "production",
      aab: release_aab_path,
      rollout: pct.to_s
    )
    UI.success("Deployed to Production at #{(pct * 100).to_i}% rollout!")
  end

  # Ships the exact build testers already used to a wider track instead of rebuilding it.
  # Idempotent: if the version code is already on the target track, only its rollout changes.
  desc "Promote a tested build (version_code:, from: internal|beta, to: beta|production, rollout:)"
  lane :promote do |options|
    code = (options[:version_code] || app_property("VERSION_CODE")).to_i
    from = options[:from] || "internal"
    to = options[:to] || UI.user_error!("Pass to:beta or to:production")
    fraction = (options[:rollout] || (to == "production" ? 0.1 : 1)).to_f
    UI.user_error!("rollout must be in (0, 1]") unless fraction > 0 && fraction <= 1

    if google_play_track_version_codes(**play_credentials, track: to).map(&:to_i).include?(code)
      UI.important("Version code #{code} is already on #{to}.")
      rollout(version_code: code, track: to, rollout: fraction) if to == "production"
      next
    end
    on_source = google_play_track_version_codes(**play_credentials, track: from).map(&:to_i)
    unless on_source.include?(code)
      UI.user_error!("Version code #{code} is not on the #{from} track (it has #{on_source.join(', ')})")
    end

    upload_to_play_store(
      **play_credentials,
      track: from, track_promote_to: to, version_code: code.to_s,
      rollout: (fraction < 1 ? fraction.to_s : nil),
      track_promote_release_status: "completed",
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true
    )
    UI.success("Promoted #{code} from #{from} to #{to}#{fraction < 1 ? " at #{(fraction * 100).round}%" : ''}.")
  end

  desc "Change the staged rollout of a release (version_code:, track: production, rollout: 0.5 or 1)"
  lane :rollout do |options|
    code = (options[:version_code] || app_property("VERSION_CODE")).to_i
    rollout = options[:rollout].to_f
    UI.user_error!("rollout must be in (0, 1]") unless rollout > 0 && rollout <= 1
    upload_to_play_store(
      **play_credentials,
      track: options[:track] || "production", version_code: code.to_s, rollout: rollout.to_s,
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_metadata: true,
      skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true
    )
    UI.success("Rollout of #{code} is now #{(rollout * 100).round}%.")
  end

  desc "Promote Internal -> Beta"
  lane :promote_to_beta do |options|
    promote(version_code: options[:version_code], from: "internal", to: "beta")
  end

  desc "Promote Beta -> Production"
  lane :promote_to_production do |options|
    promote(version_code: options[:version_code], from: "beta", to: "production", rollout: options[:rollout] || 0.1)
  end

  desc "Upload pre-built AAB to Internal (CI artifact upload)"
  lane :upload_internal do
    upload_to_play_store(
      **play_credentials,
      track: "internal",
      aab: ENV["AAB_PATH"] || release_aab_path,
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      release_status: "draft"
    )
  end

  # Play attaches listing updates to a release, so this targets the current version code on a
  # track that already has it (Mobile CD passes the track it just uploaded to).
  desc "Upload the store listing only (track: internal by default, version_code: current)"
  lane :upload_metadata do |options|
    upload_to_play_store(
      **play_credentials,
      track: options[:track] || "internal",
      version_code: (options[:version_code] || app_property("VERSION_CODE")).to_s,
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_changelogs: true,
      metadata_path: File.join(mobile_root, "fastlane", "metadata", "android")
    )
  end

end

# ============================================================================
# iOS
# ============================================================================
platform :ios do

  desc "Sync App Store certificates and profiles"
  lane :certificates do
    setup_ci if is_ci
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: ios_app_identifier
    )
  end

  desc "Sync development certificates and profiles"
  lane :certificates_dev do
    setup_ci if is_ci
    match(
      type: "development",
      readonly: is_ci,
      app_identifier: ios_app_identifier
    )
  end

  desc "Run precheck for common App Store rejection issues"
  lane :precheck_app do
    precheck(
      app_identifier: ios_app_identifier,
      unreachable_urls: :error,
      other_platforms: :error
    )
  end

  desc "Run tests on iPhone and iPad simulators"
  lane :test_ios do
    test_options = {
      scheme: "iosApp",
      devices: ["iPhone 17 Pro Max", "iPad Pro 11-inch (M5)"],
      result_bundle: true
    }
    run_tests(test_options.merge(ios_project_container))
  end

  desc "Build iOS app for App Store"
  lane :build do
    # The Xcode build phase compiles the shared Kotlin framework (embedAndSignAppleFrameworkForXcode).
    certificates

    app_id = ios_app_identifier
    team = ENV['APPLE_TEAM_ID'] || UI.user_error!("Set APPLE_TEAM_ID")

    # Do NOT put signing in xcargs — it leaks to SPM targets
    build_options = {
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "App.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: { app_id => "match AppStore #{app_id}" },
        teamID: team
      },
      xcargs: "-skipPackagePluginValidation"
    }

    build_app(build_options.merge(ios_project_container))
    UI.success("iOS app built!")
  end

  desc "Build for development/testing"
  lane :build_dev do
    certificates_dev

    build_options = {
      scheme: "iosApp",
      export_method: "development",
      output_directory: "./build",
      output_name: "App-dev.ipa"
    }
    build_app(build_options.merge(ios_project_container))
  end

  # -- Deployment lanes --

  desc "Deploy to TestFlight (internal testers)"
  lane :beta do
    next UI.important("This build is already in App Store Connect; skipping upload.") if testflight_has_build?
    build

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: generate_changelog
    )
    UI.success("Deployed to TestFlight!")
  end

  desc "Deploy to TestFlight (external testers)"
  lane :beta_external do
    next UI.important("This build is already in App Store Connect; skipping upload.") if testflight_has_build?
    build

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      notify_external_testers: true,
      # External TestFlight groups must already exist in App Store Connect.
      groups: testflight_external_groups,
      changelog: generate_changelog
    )
    UI.success("Deployed to TestFlight for external testers!")
  end

  desc "Upload to App Store Connect (no review submission)"
  lane :release do
    next UI.important("This build is already in App Store Connect; skipping upload.") if testflight_has_build?
    build

    # The store listing is uploaded separately (upload_metadata) so a binary upload never
    # overwrites it with stale or missing text.
    upload_to_app_store(
      api_key: asc_api_key,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("Uploaded to App Store Connect!")
    UI.important("Submit for review manually in App Store Connect")
  end

  desc "Upload to App Store and submit for review"
  lane :release_submit do
    precheck_app
    build
    update_copyright_year

    upload_to_app_store(
      api_key: asc_api_key,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("Submitted to App Store for review!")
  end

  desc "Upload metadata and screenshots only (no binary)"
  lane :upload_metadata do
    update_copyright_year

    deliver(
      api_key: asc_api_key,
      app_identifier: ios_app_identifier,
      app_version: app_property("VERSION_NAME"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: ios_metadata_path,
      screenshots_path: ios_screenshots_path
    )
  end

  # Promotion lanes act on a build already in App Store Connect and only call its API, so they
  # also run on Linux. app_version/build_number default to app.properties.
  desc "Give an uploaded TestFlight build to external testers (app_version:, build_number:)"
  lane :promote_external do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: ios_app_identifier,
      distribute_only: true,
      app_version: options[:app_version] || app_property("VERSION_NAME"),
      build_number: (options[:build_number] || app_property("VERSION_CODE")).to_s,
      distribute_external: true,
      notify_external_testers: true,
      groups: testflight_external_groups,
      changelog: generate_changelog
    )
    UI.success("Build is now available to external testers.")
  end

  desc "Submit an uploaded build for App Store review with a phased release (app_version:, build_number:)"
  lane :submit_for_review do |options|
    deliver(
      api_key: asc_api_key,
      app_identifier: ios_app_identifier,
      app_version: options[:app_version] || app_property("VERSION_NAME"),
      build_number: (options[:build_number] || app_property("VERSION_CODE")).to_s,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success("Submitted for review; it releases in phases after approval.")
  end

end

# ============================================================================
# SHARED / UTILITY
# ============================================================================

desc "Release notes: RELEASE_NOTES if set, otherwise recent commits"
private_lane :generate_changelog do
  notes = ENV["RELEASE_NOTES"].to_s.strip
  next notes[0, 4000] unless notes.empty?

  cl = changelog_from_git_commits(
    commits_count: 10,
    pretty: "- %s",
    date_format: "short",
    merge_commit_filtering: "exclude_merges"
  )
  cl.length > 4000 ? cl[0..3990] + "..." : cl
end

# Keeps the App Store copyright line current without publishing a placeholder. Set
# COPYRIGHT_HOLDER (for example your company) to write the whole line; otherwise only the
# year in an existing copyright.txt is updated.
private_lane :update_copyright_year do
  path = File.join(ios_metadata_path, "en-US", "copyright.txt")
  next unless File.directory?(File.dirname(path))
  holder = ENV["COPYRIGHT_HOLDER"].to_s.strip
  if !holder.empty?
    File.write(path, "#{Time.now.year} #{holder}")
  elsif File.exist?(path)
    File.write(path, File.read(path).sub(/\A\d{4}/, Time.now.year.to_s))
  else
    UI.important("Set COPYRIGHT_HOLDER to fill the App Store copyright line.")
  end
end

desc "Print changelog"
lane :changelog do
  puts generate_changelog
end

desc "Clean build artifacts"
lane :clean do
  gradle(project_dir: mobile_root, task: "clean")
  sh("rm -rf ./build")
  UI.success("Cleaned!")
end

desc "Validate environment variables"
lane :check_env do
  {
    "Android" => %w[KEYSTORE_PATH KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD],
    "iOS Match" => %w[MATCH_PASSWORD MATCH_GIT_URL],
    "App Store Connect" => %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT]
  }.each do |section, vars|
    UI.header(section)
    vars.each do |v|
      ENV[v].nil? || ENV[v].empty? ? UI.error("Missing: #{v}") : UI.success("Found: #{v}")
    end
  end
end

error do |lane, exception|
  UI.error("#{lane} failed: #{exception.message}")
end
