# Keystore configuration for release signing
# Copy this file to keystore.properties and fill in your values
# NEVER commit keystore.properties to version control
#
# To generate a new keystore:
#   keytool -genkey -v -keystore release.keystore -alias myapp -keyalg RSA -keysize 2048 -validity 10000
#
# IMPORTANT: Store your keystore and these credentials securely!
# Losing them means you cannot update your app on Google Play.

storeFile=path/to/your/release.keystore
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
