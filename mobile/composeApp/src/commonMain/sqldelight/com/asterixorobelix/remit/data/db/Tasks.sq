CREATE TABLE TaskEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    deleted INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE SyncOperation (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    FOREIGN KEY(task_id) REFERENCES TaskEntity(id) ON DELETE CASCADE
);

CREATE INDEX task_updated_idx ON TaskEntity(updated_at);
CREATE INDEX sync_next_attempt_idx ON SyncOperation(next_attempt_at);

observeVisible:
SELECT * FROM TaskEntity WHERE deleted = 0 ORDER BY completed ASC, updated_at DESC;

observeRecent:
SELECT * FROM TaskEntity WHERE deleted = 0 ORDER BY updated_at DESC LIMIT :limit;

searchVisible:
SELECT * FROM TaskEntity
WHERE deleted = 0 AND title LIKE :pattern ESCAPE '\'
ORDER BY updated_at DESC
LIMIT :limit;

selectAll:
SELECT * FROM TaskEntity ORDER BY updated_at DESC;

selectByIds:
SELECT * FROM TaskEntity WHERE id IN ?;

-- Upsert is UPDATE + INSERT OR IGNORE rather than INSERT OR REPLACE: REPLACE deletes the old
-- row first, which would cascade-delete queued SyncOperation rows if foreign keys are enabled.
updateTask:
UPDATE TaskEntity SET title = :title, completed = :completed, deleted = :deleted,
    updated_at = :updatedAt, created_at = :createdAt
WHERE id = :id;

insertTaskIfAbsent:
INSERT OR IGNORE INTO TaskEntity(id, title, completed, deleted, updated_at, created_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteTask:
DELETE FROM TaskEntity WHERE id = ?;

deleteAllTasks:
DELETE FROM TaskEntity;

enqueue:
INSERT INTO SyncOperation(id, task_id, attempt_count, next_attempt_at, last_error)
VALUES (?, ?, 0, 0, NULL);

pending:
SELECT * FROM SyncOperation WHERE next_attempt_at <= ? ORDER BY next_attempt_at ASC;

countOperations:
SELECT COUNT(*) FROM SyncOperation;

countOperationsForTask:
SELECT COUNT(*) FROM SyncOperation WHERE task_id = ?;

markFailed:
UPDATE SyncOperation SET attempt_count = ?, next_attempt_at = ?, last_error = ? WHERE id = ?;

deleteOperation:
DELETE FROM SyncOperation WHERE id = ?;

clearQueue:
DELETE FROM SyncOperation;
