# Code owners. Branch protection (scripts/protect-main.sh) requires the owner's approval only for
# pull requests that touch these paths; anything else merges once checks pass and review threads
# are resolved, so AI-agent pull requests move quickly except where a mistake is costly.
# Projects made from this template: replace @asterixorobelix with your GitHub handle if different.

# Delivery, signing, review automation, and the rules agents follow.
/.github/                                          @asterixorobelix
/.githooks/                                        @asterixorobelix
/.pr_agent.toml                                    @asterixorobelix
/.gitleaksignore                                   @asterixorobelix
/scripts/ci/                                       @asterixorobelix
/scripts/protect-main.sh                           @asterixorobelix
/scripts/check-architecture.sh                     @asterixorobelix
/mobile/fastlane/                                  @asterixorobelix
/mobile/Gemfile                                    @asterixorobelix
/mobile/Gemfile.lock                               @asterixorobelix
/AGENTS.md                                         @asterixorobelix
/CLAUDE.md                                         @asterixorobelix

# Agent guardrails and quality-gate configuration: agents must not loosen the rules they work under.
/.claude/settings.json                             @asterixorobelix
/.codex/                                           @asterixorobelix
/.mcp.json                                         @asterixorobelix
/scripts/agent-hook.sh                             @asterixorobelix
/.editorconfig                                     @asterixorobelix
/_typos.toml                                       @asterixorobelix
